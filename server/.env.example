# ---- HTTP ----
PORT=4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# ---- MongoDB (Atlas free tier or local) ----
MONGODB_URI=mongodb://127.0.0.1:27017/ledgerbridge

# ---- Login (required) ----
# Signs login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# First HQ login, created on first start only if no HQ user exists. Change the password after signing in.
BOOTSTRAP_ADMIN_USERNAME=hq
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Admin-only routes (retry failed sync). Min 16 chars. Never put this in the client. ----
# ADMIN_API_KEY=change-me-to-a-long-random-string

# ---- SharePoint / Microsoft Graph ----
# mock     = in-memory fake SharePoint (local dev, inspect at GET /api/dev/mock-ledger)
# onedrive = FREE personal OneDrive (one-time sign-in: npm run auth:onedrive), see docs/FREE_ONEDRIVE_SETUP.md
# live     = SharePoint Online via a Microsoft 365 tenant (app-only), see docs/SHAREPOINT_SETUP.md
# sheets   = FREE Google Sheet via a service account, see docs/GOOGLE_SHEETS_SETUP.md
GRAPH_MODE=mock
AZURE_TENANT_ID=
AZURE_CLIENT_ID=            # used by live AND onedrive
AZURE_CLIENT_SECRET=
SP_SITE_ID=
SP_DRIVE_ID=
SP_FOLDER_PATH=Ledgers      # folder inside the library / OneDrive

# ---- sheets mode only ----
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=   # base64 of the downloaded service-account .json key

# ---- onedrive mode only: 64 hex chars (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
# TOKEN_ENCRYPTION_KEY=

# ---- Approved-orders ledger (only runs with GRAPH_MODE=sheets) ----
# Approved orders are copied to the Google Sheet, one tab per month: Orders_2026-11. PO number and status
# changes update the same rows. Uses the same GOOGLE_SHEET_ID / service account as above.
ORDER_LEDGER_PREFIX=Orders

# ---- Demo data ----
# Simulated branches J001-J034 (logins j001...j034, password demo1234) and ~185 products across 40 suppliers,
# loaded once. Defaults to true outside production. Remove later from the Setup tab ("Remove demo data").
# SEED_DEMO_DATA=true

# ---- Ledger files ----
LEDGER_FILE_PREFIX=Sales_Ledger
# Shown in the ledger's revenue column header
LEDGER_CURRENCY=KES
# monthly => Sales_Ledger_2026-11.xlsx (recommended) | none => Sales_Ledger.xlsx
LEDGER_ROLLOVER=monthly

# ---- Sync worker ----
SYNC_POLL_MS=5000
SYNC_BATCH_SIZE=100
SYNC_MAX_ATTEMPTS=6
SYNC_BACKOFF_BASE_MS=5000
SYNC_LOCK_TIMEOUT_MS=300000
